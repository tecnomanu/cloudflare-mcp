# Cloudflare API token. Needed permissions:
#   - Zone:DNS:Edit        (DNS record tools)
#   - Zone:Read            (to resolve the zone by name)
#   - Account:Cloudflare Tunnel:Edit   (tunnel tools)
#   - Zone:Email Routing Rules:Edit    (email routing rule tools)
#   - Account:Email Routing Addresses:Edit  (email destination tools)
#   - Account:Account Settings:Read    (to auto-resolve the account id)
CLOUDFLARE_API_TOKEN=

# Zone to manage: the 32-char hex Zone ID or the zone name (e.g. example.com).
CLOUDFLARE_ZONE_ID=

# Optional. Account id for tunnel endpoints. If omitted it is resolved from the
# token (requires Account:Read).
CLOUDFLARE_ACCOUNT_ID=
